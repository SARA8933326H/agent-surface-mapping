DATABASE_URL=postgresql://postgres:postgres@localhost:5432/surface?schema=public
REDIS_URL=redis://localhost:6379
# Set to production in deployed environments: hides validation error details and Swagger docs.
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins. Never use * in production.
CORS_ORIGIN=http://localhost:3000
# Shared API key. When set, all API requests (except /health) must send it
# via the X-API-Key header. Leave empty in local dev; REQUIRED in production.
# API_KEY=change-me-to-a-long-random-string
# Frontend sends the same key (inlined into the client bundle at build time).
# NEXT_PUBLIC_API_KEY=change-me-to-a-long-random-string
# Allow scanning private/loopback/internal targets. Fine for local testing;
# leave UNSET in production or anyone can make the server crawl your internal
# network (SSRF).
ALLOW_PRIVATE_TARGETS=true
# Set to true when the API sits behind a TLS-terminating reverse proxy (Caddy, nginx, cloud LB)
# so rate limiting keys on the real client IP from X-Forwarded-For.
TRUST_PROXY=false
SCREENSHOT_DIR=./screenshots
REPORT_DIR=./reports-output
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker scaling
# WORKER_REPLICAS=2          # container count (docker compose)
# WORKER_CONCURRENCY=2       # concurrent crawl jobs per worker

# Job retries (BullMQ)
# QUEUE_ATTEMPTS=3
# QUEUE_BACKOFF_DELAY=5000   # ms, exponential backoff base

# Rate limiting
# RATE_LIMIT_TTL=60          # window in seconds
# RATE_LIMIT_LIMIT=100       # max requests per window per IP

# Vulnerability detection
# VULN_CHECKS_ENABLED=true   # passive analysis of crawled data (headers, forms, assets)
# VULN_ACTIVE_PROBES=true    # bounded read-only probes (sensitive paths, OPTIONS/TRACE, CORS, cookies)
# VULN_PROBE_TIMEOUT=5000    # ms per probe request

# Production HTTPS (docker-compose.prod.yml, Caddy issues Let's Encrypt certs)
# DOMAIN=surface.example.com
# API_DOMAIN=api.surface.example.com

# Optional: set this only if you run the crawler locally and have Playwright browsers outside the default cache
# PLAYWRIGHT_BROWSERS_PATH=D:/ms-playwright
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma:2b
# DISABLE_LLM=false
