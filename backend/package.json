{
  "name": "@surface/backend",
  "version": "0.0.1",
  "description": "NestJS API and worker for the attack surface prototype.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node scripts/run-node.js dist/main",
    "worker": "node scripts/run-node.js dist/worker",
    "db:generate": "node scripts/run-prisma.js generate",
    "db:migrate": "node scripts/run-prisma.js migrate dev",
    "db:deploy": "node scripts/run-prisma.js migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.10.0",
    "@surface/classifier": "workspace:*",
    "@surface/crawler": "workspace:*",
    "@surface/reports": "workspace:*",
    "@surface/shared": "workspace:*",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "playwright": "^1.45.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.4.2",
    "prisma": "^5.10.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.3"
  }
}
